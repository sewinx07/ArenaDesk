NODE_ENV=production
PORT=3001
# DATABASE_URL: Use the POOLED connection string (with -pooler) from Neon
DATABASE_URL=postgresql://user:password@host-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=https://your-frontend.vercel.app
